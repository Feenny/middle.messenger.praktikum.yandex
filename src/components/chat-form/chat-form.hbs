<form id="chat__message-form" class="chat__message-input hidden">
  <div
      class="chat__user-control"
    ><img
      class="chat__user-control_image"
      src="/assets/icon-user.png"
      alt=""
    /></div>
  <div id="chat__user-control_menu" class="popup-menu">
    <ul>
      <li><button id="button__add-user">Добавить пользователя</button></li>
      <li><button id="button__delete-user">Удалить пользователя</button></li>
    </ul>
  </div>
  {{{Input}}}<button class="chat__message-button"><img
      class="chat__message-button_image"
      src="/assets/send_icon.png"
      alt=""
    /></button></form>